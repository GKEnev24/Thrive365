# ── Thrive365 configuration ──────────────────────────────────────────────────
# Copy this file to ".env" and fill in what you need. Everything is optional —
# the app runs without any of it, but ThriveAI gets smarter the more you give it.

# ── ThriveAI brain ───────────────────────────────────────────────────────────
# ThriveAI tries providers in order: Gemini → local Ollama → built-in heuristic.

# 1) Gemini (RECOMMENDED — smart + free). Get a free key, no credit card:
#    https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# 2) Local Ollama fallback (optional — works offline on your own GPU).
#    Install from https://ollama.com then:  ollama pull llama3.1 && ollama pull llava
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_VISION_MODEL=llava

# If neither is set, ThriveAI uses its built-in rule-based brain. NOTE: accurate
# photo verification and general-purpose chat REQUIRE a vision-capable provider
# (Gemini or Ollama+llava). Without one, the chat runs in a limited offline mode
# and photos are accepted without real verification.

# Photo-verification strictness (0-100). If the model passes a photo but reports
# confidence below this, it's downgraded to a rejection. Higher = stricter. Default 50.
# VERIFY_MIN_CONFIDENCE=50

# ── Core app ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ADMIN_PASSWORD=admin123

# ── Google OAuth login (optional — Demo Login works without it) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
