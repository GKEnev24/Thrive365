# ── Thrive365 configuration ──────────────────────────────────────────────────
# Copy this file to ".env" and fill in what you need. Everything is optional —
# the app runs without any of it, but ThriveAI gets smarter the more you give it.

# ── ThriveAI brain ───────────────────────────────────────────────────────────
# Qwen 2.5 runs EMBEDDED inside the app via llama-cpp-python — no separate server,
# no API key, no quota. Just `pip install -r requirements.txt`; the GGUF weights
# download from Hugging Face on first run and are cached for every run after.
# If llama-cpp-python isn't installed, ThriveAI falls back to its rule-based brain.

# All of these are OPTIONAL overrides — the defaults work out of the box.
# Chat model (Hugging Face repo + GGUF filename):
# QWEN_MODEL_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
# QWEN_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
# Vision model for photo verification (GGUF + multimodal projector):
# QWEN_VISION_REPO=ggml-org/Qwen2.5-VL-3B-Instruct-GGUF
# QWEN_VISION_FILE=Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
# QWEN_VISION_MMPROJ=mmproj-Qwen2.5-VL-3B-Instruct-f16.gguf
# Context window (tokens) and GPU offload (-1 = all layers on GPU, 0 = CPU only):
# QWEN_CTX=4096
# QWEN_GPU_LAYERS=0

# Photo-verification strictness (0-100). If the model passes a photo but reports
# confidence below this, it's downgraded to a rejection. Higher = stricter. Default 50.
# VERIFY_MIN_CONFIDENCE=50

# ── Core app ─────────────────────────────────────────────────────────────────
# SECRET_KEY signs session cookies. The app boots with an INSECURE dev fallback
# if this is unset; FLASK_ENV=production refuses to boot without a real key.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Admin panel password (/admin). Change before exposing the app to anyone.
ADMIN_PASSWORD=admin123

# Local dev only — set FLASK_DEBUG=1 to enable Flask's debug mode (interactive
# debugger, auto-reload). NEVER enable in production. Default OFF.
# FLASK_DEBUG=0
# Bind address — defaults to 127.0.0.1 (localhost only). Set to 0.0.0.0 to
# expose to your LAN (e.g. testing on a phone via wifi).
# FLASK_HOST=127.0.0.1

# ── Google OAuth login (optional — Demo Login works without it) ───────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Routing & geocoding (optional) ───────────────────────────────────────────
# OpenRouteService API key — required for the /map directions feature
# (walking / cycling / driving routes with sidewalk + low-traffic safety profiles).
# Sign up free at https://openrouteservice.org/dev/#/signup (2000 req/day).
# Without a key, the routing UI loads but returns a friendly "not configured" message.
ORS_API_KEY=

# Nominatim geocoder requires a User-Agent identifying your app per their policy.
# Defaults to "Thrive365/1.0 (contact@thrive365.bg)" but please override in prod.
# NOMINATIM_USER_AGENT=Thrive365/1.0 (your-email@example.com)
